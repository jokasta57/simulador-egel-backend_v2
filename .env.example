# Configuración del servidor
PORT=8080

# Configuración de la base de datos
BD_HOST=localhost
BD_DATABASE=simulador_egel_db
BD_USER=tu_usuario_bd
BD_PASSWORD=tu_contraseña_bd
BD_DB_PORT=3306

# Clave secreta para autenticación JWT
SECRET_JWT_SEED=tu_clave_secreta

# Configuración de Cloudinary para almacenamiento de imágenes
CLOUDINARY_CLOUD_NAME=tu_nombre_cloudinary
CLOUDINARY_API_KEY=tu_api_key_cloudinary
CLOUDINARY_API_SECRET=tu_api_secret_cloudinary
